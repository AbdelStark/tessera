{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/AbdelStark/tessera/blob/main/spec/schemas/unit-costs-v1.schema.json",
  "title": "tessera.unit-costs/1",
  "description": "The v0.1 H100 unit-cost measurement of RFC-0020 'Measurement protocol': the environment, each unit's statistics and roofline data, and the cost model's projections restated with the measured costs. Written by `tessera bench unit-costs`; committed under docs/perf/v0.1/.",
  "type": "object",
  "required": [
    "schema",
    "environment",
    "protocol",
    "units",
    "projections"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "tessera.unit-costs/1"
    },
    "environment": {
      "type": "object",
      "required": [
        "device",
        "driver",
        "cuda",
        "tessera",
        "sm_clock_mhz",
        "persistence_mode",
        "ecc",
        "mig"
      ],
      "additionalProperties": false,
      "properties": {
        "device": {
          "description": "For example 'NVIDIA H100 80GB HBM3'.",
          "type": "string",
          "minLength": 1
        },
        "driver": {
          "type": "string",
          "minLength": 1
        },
        "cuda": {
          "type": "string",
          "minLength": 1
        },
        "tessera": {
          "description": "The tessera version and commit that ran the measurement.",
          "type": "string",
          "minLength": 1
        },
        "sm_clock_mhz": {
          "description": "The locked application clock.",
          "type": "integer",
          "minimum": 1
        },
        "persistence_mode": {
          "type": "boolean"
        },
        "ecc": {
          "type": "boolean"
        },
        "mig": {
          "type": "boolean"
        }
      }
    },
    "protocol": {
      "type": "object",
      "required": [
        "warmups",
        "iterations"
      ],
      "additionalProperties": false,
      "properties": {
        "warmups": {
          "type": "integer",
          "minimum": 0
        },
        "iterations": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "units": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name",
          "normalization",
          "size",
          "statistics",
          "noisy",
          "digest_matches_reference",
          "roofline"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "enum": [
              "commit",
              "lookup",
              "product_leaf",
              "glue",
              "weight_pass",
              "native_rate",
              "streaming_pass",
              "column_answer"
            ]
          },
          "normalization": {
            "description": "What one value measures, as RFC-0020's table states it: for example 'ps per committed element'.",
            "type": "string",
            "minLength": 1
          },
          "size": {
            "description": "The benchmark's size, as RFC-0020's table states it.",
            "type": "string",
            "minLength": 1
          },
          "statistics": {
            "description": "The measured runs in the unit's normalization.",
            "type": "object",
            "required": [
              "median",
              "min",
              "max",
              "cv"
            ],
            "additionalProperties": false,
            "properties": {
              "median": {
                "type": "number",
                "minimum": 0
              },
              "min": {
                "type": "number",
                "minimum": 0
              },
              "max": {
                "type": "number",
                "minimum": 0
              },
              "cv": {
                "type": "number",
                "minimum": 0
              }
            }
          },
          "noisy": {
            "type": "boolean"
          },
          "digest_matches_reference": {
            "description": "Whether the benchmark's output digest matched the CPU reference on a subsample (RFC-0020 'Statistics').",
            "type": "boolean"
          },
          "roofline": {
            "description": "Nsight Compute data for the unit's kernel.",
            "type": "object",
            "required": [
              "dram_bandwidth_gbps",
              "sm_utilization",
              "tensor_pipe_utilization"
            ],
            "additionalProperties": false,
            "properties": {
              "dram_bandwidth_gbps": {
                "type": "number",
                "minimum": 0
              },
              "sm_utilization": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "tensor_pipe_utilization": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            }
          }
        }
      }
    },
    "projections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "model",
          "context",
          "mu"
        ],
        "additionalProperties": false,
        "properties": {
          "model": {
            "type": "string",
            "minLength": 1
          },
          "context": {
            "type": "integer",
            "minimum": 0
          },
          "mu": {
            "type": "object",
            "required": [
              "linear",
              "attention",
              "weights",
              "regen",
              "streaming",
              "column_answers",
              "total"
            ],
            "additionalProperties": false,
            "properties": {
              "linear": {
                "type": "number",
                "minimum": 0
              },
              "attention": {
                "type": "number",
                "minimum": 0
              },
              "weights": {
                "type": "number",
                "minimum": 0
              },
              "regen": {
                "type": "number",
                "minimum": 0
              },
              "streaming": {
                "type": "number",
                "minimum": 0
              },
              "column_answers": {
                "type": "number",
                "minimum": 0
              },
              "total": {
                "type": "number",
                "minimum": 0
              }
            }
          }
        }
      }
    }
  }
}
