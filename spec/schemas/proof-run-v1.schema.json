{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "tessera.proof-run/1",
  "description": "Informational non-hiding protocol/1 producer receipt; only an independent verifier supplies acceptance. Test-small parameters certify nothing.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "protocol", "params", "mode", "statement_digest", "weights_root", "test_parameters", "zero_knowledge", "verifier_acceptance"],
  "properties": {
    "schema": {"const": "tessera.proof-run/1"},
    "protocol": {"const": "tessera-protocol/1"},
    "params": {"type": "string"},
    "mode": {"enum": ["Live", "NonInteractive"]},
    "statement_digest": {"type": "string", "minLength": 64, "maxLength": 64},
    "weights_root": {"type": "string", "minLength": 64, "maxLength": 64},
    "test_parameters": {"type": "boolean"},
    "zero_knowledge": {"const": false},
    "verifier_acceptance": {"const": false},
    "unproven": {
      "description": "Sampled-batch requests omitted before proving because pre-check or exact-greedy witness replay failed (02 §2.2, RFC-0071 'The statement and the batching').",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["session_id", "request_id", "code"],
        "properties": {
          "session_id": {"type": "string", "minLength": 32, "maxLength": 32},
          "request_id": {"type": "integer", "minimum": 0},
          "code": {"type": "string"}
        }
      }
    }
  }
}
