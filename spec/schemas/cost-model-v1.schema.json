{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/AbdelStark/tessera/blob/main/spec/schemas/cost-model-v1.schema.json",
  "title": "tessera.cost-model/1",
  "description": "Projections of the cost model of 08 §1 at several contexts, written by `tessera bench model` (tessera_bench::ModelReport, RFC-0020 'Executable cost model').",
  "type": "object",
  "required": [
    "schema",
    "inputs",
    "projections"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "tessera.cost-model/1"
    },
    "inputs": {
      "type": "object",
      "required": [
        "source_defaults",
        "counts",
        "unit_costs",
        "memory",
        "scenario"
      ],
      "additionalProperties": false,
      "properties": {
        "source_defaults": {
          "type": "boolean"
        },
        "counts": {
          "type": "object",
          "required": [
            "commits_per_token",
            "lookups_per_token",
            "scores_per_token_per_ctx",
            "native_ops_lin",
            "native_ops_att_per_ctx",
            "regen_full_equivalents",
            "table_rows"
          ],
          "additionalProperties": false,
          "properties": {
            "commits_per_token": {
              "type": "number",
              "minimum": 0
            },
            "lookups_per_token": {
              "type": "number",
              "minimum": 0
            },
            "scores_per_token_per_ctx": {
              "type": "number",
              "minimum": 0
            },
            "native_ops_lin": {
              "type": "number",
              "minimum": 0
            },
            "native_ops_att_per_ctx": {
              "type": "number",
              "minimum": 0
            },
            "regen_full_equivalents": {
              "type": "number",
              "minimum": 0
            },
            "table_rows": {
              "description": "M: table rows a proof commits a multiplicity for, all its tables together (RFC-0008).",
              "type": "number",
              "minimum": 0
            }
          }
        },
        "unit_costs": {
          "type": "object",
          "required": [
            "commit_ps",
            "lookup_ps",
            "product_leaf_ps",
            "glue_fraction",
            "weight_pass_gpu_s",
            "streaming_pass_ps",
            "column_answer_ps",
            "native_ops_per_s"
          ],
          "additionalProperties": false,
          "properties": {
            "commit_ps": {
              "type": "number",
              "minimum": 0
            },
            "lookup_ps": {
              "type": "number",
              "minimum": 0
            },
            "product_leaf_ps": {
              "type": "number",
              "minimum": 0
            },
            "glue_fraction": {
              "type": "number",
              "minimum": 0
            },
            "weight_pass_gpu_s": {
              "type": "number",
              "minimum": 0
            },
            "streaming_pass_ps": {
              "type": "number",
              "minimum": 0
            },
            "column_answer_ps": {
              "type": "number",
              "minimum": 0
            },
            "native_ops_per_s": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          }
        },
        "memory": {
          "type": "object",
          "required": [
            "free_bytes",
            "bytes_per_leaf"
          ],
          "additionalProperties": false,
          "properties": {
            "free_bytes": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "bytes_per_leaf": {
              "type": "number",
              "minimum": 0
            }
          }
        },
        "scenario": {
          "type": "object",
          "required": [
            "gpus",
            "batch_tokens",
            "eta",
            "target_overhead",
            "violations"
          ],
          "additionalProperties": false,
          "properties": {
            "gpus": {
              "type": "integer",
              "minimum": 1
            },
            "batch_tokens": {
              "type": "integer",
              "minimum": 1
            },
            "eta": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "target_overhead": {
              "type": "number",
              "minimum": 0
            },
            "violations": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    },
    "projections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "context",
          "mu",
          "streaming_passes",
          "proof_time_s",
          "sampling_rate",
          "detection"
        ],
        "additionalProperties": false,
        "properties": {
          "context": {
            "type": "integer",
            "minimum": 0
          },
          "mu": {
            "type": "object",
            "required": [
              "linear",
              "attention",
              "weights",
              "regen",
              "streaming",
              "column_answers",
              "tables",
              "total"
            ],
            "additionalProperties": false,
            "properties": {
              "linear": {
                "type": "number",
                "minimum": 0
              },
              "attention": {
                "type": "number",
                "minimum": 0
              },
              "weights": {
                "type": "number",
                "minimum": 0
              },
              "regen": {
                "type": "number",
                "minimum": 0
              },
              "streaming": {
                "type": "number",
                "minimum": 0
              },
              "column_answers": {
                "type": "number",
                "minimum": 0
              },
              "tables": {
                "description": "The table side of LogUp: each row's multiplicity and fraction-tree leaf, shared by the batch's tokens.",
                "type": "number",
                "minimum": 0
              },
              "total": {
                "type": "number",
                "minimum": 0
              }
            }
          },
          "streaming_passes": {
            "type": "integer",
            "minimum": 0
          },
          "proof_time_s": {
            "type": "number",
            "minimum": 0
          },
          "sampling_rate": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "detection": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    }
  }
}
