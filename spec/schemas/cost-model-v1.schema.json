{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/AbdelStark/tessera/blob/main/spec/schemas/cost-model-v1.schema.json",
  "title": "tessera.cost-model/1",
  "description": "Projections of the cost model of 08 §1 at several contexts, written by `tessera bench model` (tessera_bench::ModelReport, RFC-0020 'Executable cost model').",
  "type": "object",
  "required": [
    "schema",
    "inputs",
    "projections"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "tessera.cost-model/1"
    },
    "inputs": {
      "type": "object",
      "required": [
        "source_defaults",
        "counts",
        "unit_costs",
        "memory",
        "scenario"
      ],
      "additionalProperties": false,
      "properties": {
        "source_defaults": {
          "type": "boolean"
        },
        "counts": {
          "type": "object",
          "required": [
            "commits_per_token",
            "lookups_per_token",
            "scores_per_token_per_ctx",
            "native_ops_lin",
            "native_ops_att_per_ctx",
            "regen_full_equivalents",
            "table_rows",
            "score_block",
            "reduction_stages"
          ],
          "additionalProperties": false,
          "properties": {
            "commits_per_token": {
              "type": "number",
              "minimum": 0
            },
            "lookups_per_token": {
              "type": "number",
              "minimum": 0
            },
            "scores_per_token_per_ctx": {
              "type": "number",
              "minimum": 0
            },
            "native_ops_lin": {
              "type": "number",
              "minimum": 0
            },
            "native_ops_att_per_ctx": {
              "type": "number",
              "minimum": 0
            },
            "regen_full_equivalents": {
              "type": "number",
              "minimum": 0
            },
            "table_rows": {
              "description": "M: table rows a proof commits a multiplicity for, all its tables together (RFC-0008).",
              "type": "number",
              "minimum": 0
            },
            "score_block": {
              "description": "b, the score block of RFC-0034: a token commits A·(S + min(S, b)) scores at context S.",
              "type": "number",
              "minimum": 0
            },
            "reduction_stages": {
              "description": "The reduction stages' sumcheck tables by size, stage 1 first (RFC-0055 'Working sets').",
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "tables"
                ],
                "additionalProperties": false,
                "properties": {
                  "tables": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": [
                        "per_token",
                        "windowable",
                        "log2_entries",
                        "count"
                      ],
                      "additionalProperties": false,
                      "properties": {
                        "per_token": {
                          "description": "Whether the tables grow with the batch: a batch of T tokens, padded to a power of two, gives each log2_entries + ⌈log2 T⌉ variables.",
                          "type": "boolean"
                        },
                        "windowable": {
                          "description": "Whether a window may fold them: an elementwise relation's operands; a matrix product's tables stay resident (RFC-0055 'The window').",
                          "type": "boolean"
                        },
                        "log2_entries": {
                          "description": "log2 of one table's entries, per token when per_token.",
                          "type": "integer",
                          "minimum": 0
                        },
                        "count": {
                          "description": "The tables of this size.",
                          "type": "number",
                          "minimum": 0
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "unit_costs": {
          "type": "object",
          "required": [
            "commit_ps",
            "lookup_ps",
            "product_leaf_ps",
            "glue_fraction",
            "weight_pass_gpu_s",
            "streaming_pass_ps",
            "merge_ps",
            "window_ps",
            "column_answer_ps",
            "row_combination_ps",
            "native_ops_per_s"
          ],
          "additionalProperties": false,
          "properties": {
            "commit_ps": {
              "type": "number",
              "minimum": 0
            },
            "lookup_ps": {
              "type": "number",
              "minimum": 0
            },
            "product_leaf_ps": {
              "type": "number",
              "minimum": 0
            },
            "glue_fraction": {
              "type": "number",
              "minimum": 0
            },
            "weight_pass_gpu_s": {
              "type": "number",
              "minimum": 0
            },
            "streaming_pass_ps": {
              "description": "c_s: picoseconds per table leaf of one streamed round over the table trees, which regenerates nothing (RFC-0054).",
              "type": "number",
              "minimum": 0
            },
            "merge_ps": {
              "description": "c_m: picoseconds per merged tensor element of a grouped leaf stage (RFC-0054 'The merge').",
              "type": "number",
              "minimum": 0
            },
            "window_ps": {
              "description": "c_w: picoseconds per table entry of a windowed reduction stage, its fold at the window's challenges (RFC-0055 'Cost').",
              "type": "number",
              "minimum": 0
            },
            "column_answer_ps": {
              "type": "number",
              "minimum": 0
            },
            "row_combination_ps": {
              "type": "number",
              "minimum": 0
            },
            "native_ops_per_s": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          }
        },
        "memory": {
          "type": "object",
          "required": [
            "free_bytes",
            "bytes_per_leaf"
          ],
          "additionalProperties": false,
          "properties": {
            "free_bytes": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "bytes_per_leaf": {
              "type": "number",
              "minimum": 0
            }
          }
        },
        "scenario": {
          "type": "object",
          "required": [
            "gpus",
            "batch_tokens",
            "eta",
            "target_overhead",
            "violations"
          ],
          "additionalProperties": false,
          "properties": {
            "gpus": {
              "type": "integer",
              "minimum": 1
            },
            "batch_tokens": {
              "type": "integer",
              "minimum": 1
            },
            "eta": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "target_overhead": {
              "type": "number",
              "minimum": 0
            },
            "violations": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    },
    "projections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "context",
          "mu",
          "leaf_groups",
          "table_rounds",
          "reduction_stages",
          "proof_time_s",
          "sampling_rate",
          "detection"
        ],
        "additionalProperties": false,
        "properties": {
          "context": {
            "type": "integer",
            "minimum": 0
          },
          "mu": {
            "type": "object",
            "required": [
              "linear",
              "attention",
              "weights",
              "regen",
              "streaming",
              "column_answers",
              "row_combination",
              "tables",
              "total"
            ],
            "additionalProperties": false,
            "properties": {
              "linear": {
                "type": "number",
                "minimum": 0
              },
              "attention": {
                "type": "number",
                "minimum": 0
              },
              "weights": {
                "type": "number",
                "minimum": 0
              },
              "regen": {
                "description": "Witness regenerations: n_regen, a grouped leaf stage's merge pass (RFC-0054) and each windowed reduction stage's fold pass (RFC-0055).",
                "type": "number",
                "minimum": 0
              },
              "streaming": {
                "description": "The memory plans beside their regenerations: a grouped leaf stage's merge folds and the table trees' streamed rounds (RFC-0054), and the windowed reduction stages' folds (RFC-0055).",
                "type": "number",
                "minimum": 0
              },
              "column_answers": {
                "type": "number",
                "minimum": 0
              },
              "row_combination": {
                "description": "The opening pass's combination of every committed element into the combined rows (RFC-0018 P4).",
                "type": "number",
                "minimum": 0
              },
              "tables": {
                "description": "The table side of LogUp: each row's multiplicity and fraction-tree leaf, shared by the batch's tokens.",
                "type": "number",
                "minimum": 0
              },
              "total": {
                "type": "number",
                "minimum": 0
              }
            }
          },
          "leaf_groups": {
            "description": "G: the leaf stage's token groups, 1 while its lookup trees and product forests fit in memory (RFC-0054).",
            "type": "integer",
            "minimum": 1,
            "maximum": 16384
          },
          "table_rounds": {
            "description": "The table trees' streamed rounds, summed over their levels (RFC-0054 'The table batch').",
            "type": "integer",
            "minimum": 0
          },
          "reduction_stages": {
            "description": "Each reduction stage's working set at the scenario's batch and the rounds its window answers, 0 when its tables fit (RFC-0055).",
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "bytes",
                "window_rounds"
              ],
              "additionalProperties": false,
              "properties": {
                "bytes": {
                  "description": "The stage's tables at 16 bytes per entry.",
                  "type": "number",
                  "minimum": 0
                },
                "window_rounds": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          },
          "proof_time_s": {
            "type": "number",
            "minimum": 0
          },
          "sampling_rate": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "detection": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    }
  }
}
